{
  "name": "hoos-riding",
  "version": "0.1.0",
  "private": true,
  "description": "UVA bus tracker PWA",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "icons": "node scripts/make-icons.js",
    "preview": "concurrently -n server,web -c blue,magenta \"npm:start\" \"vite preview\"",
    "record": "node --env-file-if-exists=.env scripts/record-demo.js",
    "places": "node --env-file-if-exists=.env scripts/lookup-places.js",
    "qr": "node scripts/make-qr.js",
    "cav": "node scripts/make-cav.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT"
}
