# Copy to .env and fill in

# Server: the UVA tracker's public page key (see samples/README.md)
TRANSLOC_API_KEY=

# Website: a Google Maps JavaScript API key (restrict it to your site addresses, e.g. http://localhost:5173/*)
VITE_GOOGLE_MAPS_KEY=
# Optional: a Map ID from Google Cloud. Leave blank to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=

# Server only: a second Google key for Places API (New) + Routes API.
# NEVER add a VITE_ prefix: that would send it to every phone.
GOOGLE_SERVER_KEY=

# Server only: Supabase (free database for rider reports + Google usage counts).
# Supabase → Project Settings → API Keys. NEVER add a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server only, optional: password for the private /admin page (8+ characters).
# Leave blank to turn the admin page off.
ADMIN_PASSWORD=

# Server only, optional: web push keys for leave-now class reminders.
# Make a pair with: npx web-push generate-vapid-keys   (leave blank = reminders off)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
